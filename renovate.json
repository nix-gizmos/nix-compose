{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "nixpkgs"
      ],
      "commitMessageExtra": "({{{newVersion}}})"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "nix-oci"
      ],
      "commitMessagePrefix": "chore(deps):",
      "commitMessageExtra": "({{{newVersion}}})"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "commitMessagePrefix": "build(deps):",
      "prBodyNotes": [
        "This PR is opened as soon as Go publishes the release, off the weekly schedule. The locked `go-overlay` is usually older than the release, so CI fails with ``attribute '\"X.Y.Z\"' missing`` until you run `nix flake update go-overlay` on this branch and push. go-overlay adds a release's manifest within hours of go.dev; if the update finds none yet, try again later."
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "go-overlay"
      ],
      "commitMessagePrefix": "chore(deps):",
      "commitMessageExtra": "({{{newVersion}}})"
    },
    {
      "description": "These actions tag their releases vN only, with no vN.N.N. helpers:pinGitHubActionDigestsToSemver extracts vN.N.N tags only, so it would find no versions for them; take vN here.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "cachix/cachix-action",
        "DeterminateSystems/nix-installer-action",
        "DeterminateSystems/magic-nix-cache-action"
      ],
      "extractVersion": "^(?<version>v\\d+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Go release pinned in flake.nix and provided by go-overlay. nixpkgs' default `go` is not what this repo builds with, so the gomod manager's view of the go directive is not the thing to track.",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*goVersion\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver"
    }
  ]
}
